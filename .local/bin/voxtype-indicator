#!/usr/bin/env python3
"""Voxtype dictation indicator for niri (gtk-layer-shell)."""
from __future__ import annotations

import math
import os
import signal
import sys
import threading
import time
import traceback

import cairo
import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell

LOG = "/tmp/voxtype-indicator.log"
LOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "voxtype-indicator.lock")
STATE_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "voxtype", "state")
BOTTOM_MARGIN = 168
SIZE = 120
SHOW = {"recording", "listening", "transcribing", "processing", "busy"}
ACCENT = {
    "recording": (1.0, 0.22, 0.32),
    "listening": (1.0, 0.22, 0.32),
    "transcribing": (0.30, 0.78, 1.0),
    "processing": (0.30, 0.78, 1.0),
    "busy": (1.0, 0.78, 0.22),
}


def log(msg: str) -> None:
    try:
        with open(LOG, "a", encoding="utf-8") as f:
            f.write(time.strftime("%H:%M:%S ") + msg + "\n")
            f.flush()
    except Exception:
        pass


def acquire_lock() -> bool:
    if os.path.exists(LOCK):
        try:
            pid = int(open(LOCK).read().strip() or "0")
            if pid > 0 and os.path.exists(f"/proc/{pid}"):
                cmd = open(f"/proc/{pid}/cmdline", "rb").read().decode("utf-8", "ignore")
                if "voxtype-indicator" in cmd:
                    log(f"another instance alive pid={pid}")
                    return False
        except Exception:
            pass
        try:
            os.unlink(LOCK)
        except Exception:
            pass
    fd = os.open(LOCK, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    os.write(fd, str(os.getpid()).encode())
    os.close(fd)
    return True


class Dot(Gtk.Window):
    def __init__(self, monitor: Gdk.Monitor, label: str):
        super().__init__()
        self.state = "idle"
        self.phase = 0.0
        self.label = label
        self.set_app_paintable(True)
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_accept_focus(False)
        self.set_can_focus(False)
        self.set_size_request(SIZE, SIZE)
        self.set_default_size(SIZE, SIZE)

        visual = self.get_screen().get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)

        geom = monitor.get_geometry()
        left = max(0, (geom.width - SIZE) // 2)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "voxtype-indicator")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_exclusive_zone(self, -1)
        GtkLayerShell.set_monitor(self, monitor)
        # Fixed-size pill: left + bottom only (no horizontal stretch).
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, left)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, BOTTOM_MARGIN)

        self.connect("draw", self.on_draw)
        self.connect("realize", self.on_realize)
        self.connect("size-allocate", self.on_alloc)
        self.show_all()

    def on_alloc(self, _w, alloc):
        if getattr(self, "_logged_alloc", None) != (alloc.width, alloc.height):
            self._logged_alloc = (alloc.width, alloc.height)
            log(f"{self.label} alloc={alloc.width}x{alloc.height}")

    def on_realize(self, *_):
        win = self.get_window()
        if win is None:
            return
        try:
            win.set_pass_through(True)
        except Exception:
            pass
        try:
            stub = cairo.Region(cairo.RectangleInt(0, 0, 1, 1))
            self.input_shape_combine_region(stub)
            win.input_shape_combine_region(stub, 0, 0)
        except Exception as e:
            log(f"clickthrough: {e}")

    def set_state(self, state: str):
        state = (state or "idle").lower()
        if state != self.state:
            self.state = state
            log(f"{self.label} state {state}")
            self.queue_draw()
        return False

    def on_draw(self, _w, cr):
        w = self.get_allocated_width()
        h = self.get_allocated_height()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if self.state not in SHOW:
            return False

        cx, cy = w / 2, h / 2
        accent = ACCENT.get(self.state, ACCENT["busy"])
        t = self.phase
        recording = self.state in {"recording", "listening"}
        breath = 0.55 + 0.45 * (0.5 + 0.5 * math.sin(t * 1.6))

        # Strong outer glow — readable on dark UI.
        cr.set_source_rgba(accent[0], accent[1], accent[2], 0.28 + 0.18 * breath)
        cr.arc(cx, cy, 46 + 10 * breath, 0, 2 * math.pi)
        cr.fill()

        if recording:
            for i in range(3):
                u = (t * 0.25 + i / 3.0) % 1.0
                r = 22 + u * 36
                cr.set_line_width(3.2 - u)
                cr.set_source_rgba(accent[0], accent[1], accent[2], (1.0 - u) * 0.75)
                cr.arc(cx, cy, r, 0, 2 * math.pi)
                cr.stroke()
        else:
            spin = t * 2.4
            cr.set_line_width(4.0)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.set_source_rgba(accent[0], accent[1], accent[2], 1.0)
            cr.arc(cx, cy, 30, spin, spin + 1.8)
            cr.stroke()

        body = 20 + 3 * breath
        cr.set_source_rgba(accent[0], accent[1], accent[2], 1.0)
        cr.arc(cx, cy, body, 0, 2 * math.pi)
        cr.fill()
        # white core
        cr.set_source_rgba(1, 1, 1, 1.0)
        cr.arc(cx, cy, 7.5, 0, 2 * math.pi)
        cr.fill()
        return False


def pick_monitors(display: Gdk.Display):
    """Prefer landscape primary (Xiaomi); also put a copy on every monitor."""
    n = display.get_n_monitors()
    mons = [display.get_monitor(i) for i in range(n)]
    return mons


class App:
    def __init__(self):
        self.state = "idle"
        self.phase = 0.0
        display = Gdk.Display.get_default()
        self.dots = []
        for i, m in enumerate(pick_monitors(display)):
            g = m.get_geometry()
            label = f"m{i}:{g.width}x{g.height}"
            self.dots.append(Dot(m, label))
            log(f"monitor {label} at {g.x},{g.y}")
        GLib.timeout_add(33, self._tick)
        threading.Thread(target=self._poll, daemon=True).start()

    def _tick(self):
        self.phase = (self.phase + 0.12) % (2 * math.pi * 10)
        for d in self.dots:
            d.phase = self.phase
            if d.state in SHOW:
                d.queue_draw()
        return True

    def set_state(self, state: str):
        self.state = (state or "idle").lower()
        for d in self.dots:
            d.set_state(self.state)
        return False

    def _poll(self):
        last = ""
        while True:
            st = "idle"
            try:
                with open(STATE_FILE, "r", encoding="utf-8") as f:
                    st = (f.read() or "idle").strip().lower() or "idle"
            except Exception:
                pass
            if st != last:
                last = st
                GLib.idle_add(self.set_state, st)
            time.sleep(0.08)


def main() -> int:
    open(LOG, "w", encoding="utf-8").write("boot\n")
    if not acquire_lock():
        return 0

    def cleanup(*_):
        try:
            os.unlink(LOCK)
        except Exception:
            pass
        try:
            Gtk.main_quit()
        except Exception:
            pass

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)
    try:
        App()
        Gtk.main()
    except Exception:
        log("FATAL:\n" + traceback.format_exc())
        raise
    finally:
        try:
            os.unlink(LOCK)
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception:
        log("UNCAUGHT:\n" + traceback.format_exc())
        raise
