[
  { "id": "kitty",     "name": "kitty",       "template": "kitty.conf",    "target": "~/.config/kitty/themes/angelos.conf", "reload": "pkill -USR1 -x kitty" },
  { "id": "foot",      "name": "foot",        "template": "foot.ini",      "target": "~/.config/foot/themes/angelos" },
  { "id": "alacritty", "name": "Alacritty",   "template": "alacritty.toml","target": "~/.config/alacritty/themes/angelos.toml" },
  { "id": "gtk3",      "name": "GTK 3",       "template": "gtk3.css",      "target": "~/.config/gtk-3.0/angelos.css" },
  { "id": "gtk4",      "name": "GTK 4 / libadwaita", "template": "gtk4.css", "target": "~/.config/gtk-4.0/angelos.css" },
  { "id": "gtk-scheme","name": "GTK color-scheme", "command": "gsettings set org.gnome.desktop.interface color-scheme prefer-{{mode}}; gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3{{gtkSuffix}}" },
  { "id": "niri",      "name": "niri (рамки окон)", "template": "niri.kdl", "target": "~/.config/niri/angelos.kdl" }
]
