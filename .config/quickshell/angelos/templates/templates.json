[
  { "id": "terminal-hell", "name": "Терминал в аду (фон kitty, реплика в fish)", "command": "python3 {{shellDir}}/scripts/terminal-hell.py {{paletteFile}}",
    "writes": ["~/.local/share/angelos/terminal/{realm,hell.png,hell-lines.txt}", "~/.config/fish/conf.d/angelos-realm.fish"] },
  { "id": "kitty",     "name": "kitty",       "template": "kitty.conf",    "target": "~/.config/kitty/themes/angelos.conf", "reload": "pkill -USR1 -x kitty", "terminal": true },
  { "id": "foot",      "name": "foot",        "template": "foot.ini",      "target": "~/.config/foot/themes/angelos", "terminal": true },
  { "id": "alacritty", "name": "Alacritty",   "template": "alacritty.toml","target": "~/.config/alacritty/themes/angelos.toml", "terminal": true },
  { "id": "gtk3",      "name": "GTK 3",       "template": "gtk3.css",      "target": "~/.config/gtk-3.0/angelos.css", "apps": true },
  { "id": "gtk4",      "name": "GTK 4 / libadwaita", "template": "gtk4.css", "target": "~/.config/gtk-4.0/angelos.css", "apps": true },
  { "id": "gtk-scheme","name": "GTK color-scheme", "apps": true, "command": "gsettings set org.gnome.desktop.interface color-scheme prefer-{{mode}}; [ -n \"{{decorGtk}}\" ] || gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3{{gtkSuffix}}" },
  { "id": "gtk-live",  "name": "GTK: окна angelOS (рай/ад, кнопки)", "command": "python3 {{shellDir}}/scripts/gtk-live.py {{paletteFile}}",
    "writes": ["~/.config/gtk-4.0/angelos-decor.css", "~/.config/gtk-4.0/assets/{close,maximize,minimize,close-hover}.svg",
               "~/.local/share/themes/angelOS-{a,b}/{index.theme,gtk-3.0/gtk.css,gtk-4.0/gtk.css}",
               "~/.local/share/themes/angelOS-{a,b}/gtk-{3,4}.0/assets/{close,maximize,minimize,close-hover}.svg",
               "~/.config/gtk-{3,4}.0/assets/frame-{raised,sunken}.svg",
               "~/.local/share/themes/angelOS-{a,b}/gtk-{3,4}.0/assets/frame-{raised,sunken}.svg"] },
  { "id": "helium",    "name": "Браузеры: тема рай/ад (Helium, Chromium, Firefox)", "command": "python3 {{shellDir}}/scripts/browser-theme.py build {{paletteFile}}",
    "writes": ["~/.local/share/angelos/helium/theme/manifest.json", "~/.local/share/angelos/browsers/firefox/angelos-theme.css"] },
  { "id": "telegram",  "name": "Telegram: тема рай/ад (на лету)", "command": "python3 {{shellDir}}/scripts/telegram-theme.py build {{paletteFile}}",
    "writes": ["~/.local/share/angelos/telegram/angelOS.tdesktop-theme"] },
  { "id": "qt",        "name": "Qt: qt6ct (рай/ад, пиксельный стиль)", "command": "python3 {{shellDir}}/scripts/qt-theme.py {{paletteFile}}",
    "writes": ["~/.config/qt6ct/colors/angelos.conf", "~/.config/qt6ct/qss/angelos.qss", "~/.config/qt6ct/qt6ct.conf",
               "~/.config/qt6ct/qss/angelos-frame-{raised,sunken,default,focus}.png"] },
  { "id": "niri",      "name": "niri (рамки окон)", "template": "niri.kdl", "target": "~/.config/niri/angelos.kdl" }
]
