// angelOS {{flavor}} / {{mode}} — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "{{accent}}"
        inactive-color "{{lo}}"
        urgent-color   "{{danger}}"
    }
    border {
        active-color   "{{accent}}"
        inactive-color "{{lo}}"
        urgent-color   "{{danger}}"
    }
    tab-indicator {
        active-color   "{{accent}}"
        inactive-color "{{accent4}}"
        urgent-color   "{{danger}}"
    }
    insert-hint {
        color "{{accent}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{accent}}"
        urgent-color "{{danger}}"
    }
}
