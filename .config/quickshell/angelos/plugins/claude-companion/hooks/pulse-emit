#!/bin/sh
# pulse-emit — generic emitter for the pulse protocol (angelOS port of
# lowcache/claude-companion, MIT). For agents other than Claude Code.
#   pulse-emit <event> [session] [model] [in] [out] [cacheCreate] [cacheRead]
# Fail-open: always exits 0, dispatch capped at 3 s.
event="${1:-idle}"
session="$2"
clean() { printf '%s' "$1" | tr -cd 'A-Za-z0-9._?-'; }
payload=""
if [ -n "$session" ]; then
  payload="$(clean "${3:-?}"),$(clean "${4:-0}"),$(clean "${5:-0}"),$(clean "${6:-0}"),$(clean "${7:-0}"),$(clean "$session")"
fi
if [ -n "$PULSE_DRYRUN" ]; then
  echo "qs -c angelos ipc call claude event $event $payload"
  exit 0
fi
timeout 3 qs -c angelos ipc call claude event "$event" "$payload" >/dev/null 2>&1
exit 0
