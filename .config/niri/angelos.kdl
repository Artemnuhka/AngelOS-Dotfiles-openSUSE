// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#b38aad"
        inactive-color "#1a1921"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#b38aad"
        inactive-color "#1a1921"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#b38aad"
        inactive-color "#ccb1c8"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#b38aad80"
    }
}

recent-windows {
    highlight {
        active-color "#b38aad"
        urgent-color "#ff4f6d"
    }
}
