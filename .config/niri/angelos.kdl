// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#8ab3af"
        inactive-color "#171c21"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#8ab3af"
        inactive-color "#171c21"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#8ab3af"
        inactive-color "#b1ccc9"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#8ab3af80"
    }
}

recent-windows {
    highlight {
        active-color "#8ab3af"
        urgent-color "#ff4f6d"
    }
}
