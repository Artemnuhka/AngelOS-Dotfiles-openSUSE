// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#b38391"
        inactive-color "#1a181f"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#b38391"
        inactive-color "#1a181f"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#b38391"
        inactive-color "#ccadb6"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#b3839180"
    }
}

recent-windows {
    highlight {
        active-color "#b38391"
        urgent-color "#ff4f6d"
    }
}
