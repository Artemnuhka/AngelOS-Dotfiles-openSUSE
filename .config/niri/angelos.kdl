// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#8ab3b3"
        inactive-color "#171c22"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#8ab3b3"
        inactive-color "#171c22"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#8ab3b3"
        inactive-color "#b1cccc"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#8ab3b380"
    }
}

recent-windows {
    highlight {
        active-color "#8ab3b3"
        urgent-color "#ff4f6d"
    }
}
