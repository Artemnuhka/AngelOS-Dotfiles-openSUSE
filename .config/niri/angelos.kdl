// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#8a93b3"
        inactive-color "#171922"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#8a93b3"
        inactive-color "#171922"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#8a93b3"
        inactive-color "#b1b7cc"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#8a93b380"
    }
}

recent-windows {
    highlight {
        active-color "#8a93b3"
        urgent-color "#ff4f6d"
    }
}
