// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#978ab3"
        inactive-color "#181922"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#978ab3"
        inactive-color "#181922"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#978ab3"
        inactive-color "#b9b1cc"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#978ab380"
    }
}

recent-windows {
    highlight {
        active-color "#978ab3"
        urgent-color "#ff4f6d"
    }
}
