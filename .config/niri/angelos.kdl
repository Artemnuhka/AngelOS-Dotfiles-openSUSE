// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#8d95ba"
        inactive-color "#171a22"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#8d95ba"
        inactive-color "#171a22"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#8d95ba"
        inactive-color "#b3b9d0"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#8d95ba80"
    }
}

recent-windows {
    highlight {
        active-color "#8d95ba"
        urgent-color "#ff4f6d"
    }
}
