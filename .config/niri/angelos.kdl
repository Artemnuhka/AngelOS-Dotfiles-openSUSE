// angelOS wallpaper / dark — generated by angelOS, do not edit
layout {
    focus-ring {
        active-color   "#b59a8c"
        inactive-color "#1a1a1f"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#b59a8c"
        inactive-color "#1a1a1f"
        urgent-color   "#ff4f6d"
    }
    tab-indicator {
        active-color   "#b59a8c"
        inactive-color "#cdbbb2"
        urgent-color   "#ff4f6d"
    }
    insert-hint {
        color "#b59a8c80"
    }
}

recent-windows {
    highlight {
        active-color "#b59a8c"
        urgent-color "#ff4f6d"
    }
}
