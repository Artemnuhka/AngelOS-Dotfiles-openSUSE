        active-color   "#ff2e7e"
        inactive-color "#0e0716"
        urgent-color   "#ff4f6d"
    }
    border {
        active-color   "#ff2e7e"
        inactive-color "#0e0716"
        urgent-color   "#ff4f6d"
    }
